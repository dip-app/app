rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function own(uid) { return verified() && request.auth.uid == uid; }
    function text(value, maximum) { return value is string && value.size() <= maximum; }
    function validItem(values, index) {
      return values.size() <= index ||
        (values[index] is string && values[index].size() > 0 && values[index].size() <= 120);
    }
    // Rules do not provide list iteration. Check every position in the bounded list.
    function stringList(values) {
      return values is list && values.size() <= 10
        && validItem(values, 0)
        && validItem(values, 1)
        && validItem(values, 2)
        && validItem(values, 3)
        && validItem(values, 4)
        && validItem(values, 5)
        && validItem(values, 6)
        && validItem(values, 7)
        && validItem(values, 8)
        && validItem(values, 9);
    }
    function validProfile(data) {
      return data.keys().hasOnly([
          'companyId', 'displayName', 'email', 'photoURL', 'avatarId', 'department',
          'jobTitle', 'city', 'role', 'interestTagIds', 'travelRadiusMiles',
          'availability', 'friendIds', 'favoritePhotoIds', 'pointsBalance', 'createdAt'
        ])
        && data.displayName is string && data.displayName.size() <= 80
        && data.displayName.matches('^[^\\s](.*[^\\s])?$')
        && text(data.photoURL, 2048) && text(data.avatarId, 120)
        && text(data.department, 120) && text(data.jobTitle, 120) && text(data.city, 120)
        && stringList(data.interestTagIds) && stringList(data.availability)
        && data.travelRadiusMiles is int && data.travelRadiusMiles >= 0
        && data.travelRadiusMiles <= 500;
    }
    function memberCompany() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
    }
    function sameCompany(companyId) { return verified() && memberCompany() == companyId; }
    // Organizers are manually assigned (role "admin" on the server-owned membership document).
    function organizer(companyId) {
      return sameCompany(companyId)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /users/{uid} {
      // Missing self documents must be observable to enter company onboarding.
      allow get: if own(uid);
      allow update: if own(uid)
        // displayName comes from OAuth and is written only by resolveMembershipV1 (ADR 0007).
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'photoURL', 'avatarId', 'department', 'jobTitle', 'city',
          'interestTagIds', 'travelRadiusMiles', 'availability'
        ]) && validProfile(request.resource.data);
    }
    match /companies/{companyId} {
      allow get: if verified()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
    }
    // Company lookup by companies.emailDomain happens only in resolveMembershipV1
    // (Admin SDK); clients may get their own company document but never list/query
    // companies or write emailDomain. accountRateLimits is server-only as well:
    // both fall through to the deny-all rules.
    // Preserve organizer portal reads; member queries are bounded and tenant-constrained.
    match /companies/{companyId}/events/{eventId} {
      allow get: if sameCompany(companyId) &&
        (!exists(/databases/$(database)/documents/companies/$(companyId)/events/$(eventId))
          || (resource.data.companyId == companyId
            && (resource.data.status == 'scheduled' || organizer(companyId))));
      allow list: if organizer(companyId)
        || (sameCompany(companyId)
          && request.query.limit != null && request.query.limit <= 100
          && resource.data.companyId == companyId && resource.data.status == 'scheduled');
      // Client mutations, RSVP rows and private command receipts remain denied.
    }
    // RSVP rows are written only by setRsvpV1 (Admin SDK). Members get their own row in any
    // state (including a missing row, so a listener can observe "not joined yet") and see
    // same-company "going" rows, whose trusted snapshots (userName, userAvatarId,
    // userDepartment) form the attendee list. Lists are bounded.
    match /companies/{companyId}/events/{eventId}/rsvps/{userId} {
      allow get: if sameCompany(companyId)
        && ((userId == request.auth.uid && (resource == null || resource.data.companyId == companyId))
          || (resource != null && resource.data.companyId == companyId && resource.data.status == 'going'));
      allow list: if sameCompany(companyId)
        && request.query.limit != null && request.query.limit <= 100
        && resource.data.companyId == companyId && resource.data.status == 'going';
    }
    // My Events: a collection-group query over the caller's own "going" RSVPs in their company.
    match /{path=**}/rsvps/{rsvpId} {
      allow list: if verified()
        && request.query.limit != null && request.query.limit <= 100
        && resource.data.userId == request.auth.uid
        && resource.data.companyId == memberCompany()
        && resource.data.status == 'going';
    }
    // Weekly themes (challenges): written only by createChallengeV1/updateChallengeV1 (Admin SDK);
    // participantCount/completedCount are server-owned. Same-company verified members get any theme
    // (a missing one is observable) and list with a limit <= 20; organizers may list without a limit.
    // The path scopes the tenant and only the server writes these documents, so list queries need no
    // companyId filter (the iOS Home query is a single-field endDate range, no composite index).
    // Submissions and participant rows stay denied until their V2 commands exist.
    match /companies/{companyId}/challenges/{challengeId} {
      allow get: if sameCompany(companyId) &&
        (!exists(/databases/$(database)/documents/companies/$(companyId)/challenges/$(challengeId))
          || resource.data.companyId == companyId);
      allow list: if sameCompany(companyId)
        && (organizer(companyId) || (request.query.limit != null && request.query.limit <= 20));
    }
    match /tags/{tagId} {
      allow read: if verified();
    }
    // --- Activity chat, notification preferences (notifications module, docs/contracts/callables.md) ---
    // Chat: same-company members with a "going" RSVP read and append; no edit/delete. The message ID is the
    // client-generated clientMessageId, so a retry can never create a duplicate. Author display fields must
    // equal the caller's server-owned profile. Writable while the event is scheduled and until 24 h after
    // endTime; history stays readable for going participants. Lists must set a limit <= 100.
    match /companies/{companyId}/events/{eventId}/messages/{messageId} {
      function chatEventPath() { return /databases/$(database)/documents/companies/$(companyId)/events/$(eventId); }
      function chatRsvpPath() { return /databases/$(database)/documents/companies/$(companyId)/events/$(eventId)/rsvps/$(request.auth.uid); }
      function chatParticipant() {
        return sameCompany(companyId) && exists(chatRsvpPath())
          && get(chatRsvpPath()).data.companyId == companyId && get(chatRsvpPath()).data.status == 'going';
      }
      function validMessage(data) {
        let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return data.keys().hasOnly(['companyId', 'eventId', 'authorId', 'authorName', 'authorAvatarId', 'text', 'createdAt'])
          && data.keys().hasAll(['companyId', 'eventId', 'authorId', 'authorName', 'authorAvatarId', 'text', 'createdAt'])
          && data.companyId == companyId && data.eventId == eventId && data.authorId == request.auth.uid
          && data.authorName == profile.displayName && data.authorAvatarId == profile.avatarId
          && data.text is string && data.text.size() >= 1 && data.text.size() <= 1000 && data.text == data.text.trim()
          && data.createdAt == request.time;
      }
      function chatOpen() {
        let event = get(chatEventPath()).data;
        return event.companyId == companyId && event.status == 'scheduled'
          && request.time < event.endTime + duration.value(24, 'h');
      }
      allow get: if chatParticipant() && (resource == null || resource.data.companyId == companyId);
      allow list: if chatParticipant() && request.query.limit != null && request.query.limit <= 100;
      allow create: if chatParticipant() && messageId.matches('^[A-Za-z0-9_-]{8,128}$')
        && validMessage(request.resource.data) && exists(chatEventPath()) && chatOpen();
    }
    // Notification preference: own document only, {level, updatedAt} with a server timestamp; requires an
    // RSVP row (current or past) in this company. Missing document = "none". No delete; no list.
    match /companies/{companyId}/events/{eventId}/subscriptions/{userId} {
      function subscriptionRsvpPath() { return /databases/$(database)/documents/companies/$(companyId)/events/$(eventId)/rsvps/$(userId); }
      allow get: if own(userId) && sameCompany(companyId);
      allow create, update: if own(userId) && sameCompany(companyId)
        && exists(subscriptionRsvpPath()) && get(subscriptionRsvpPath()).data.companyId == companyId
        && request.resource.data.keys().hasOnly(['level', 'updatedAt'])
        && request.resource.data.keys().hasAll(['level', 'updatedAt'])
        && request.resource.data.level in ['all', 'changes', 'reminders', 'none']
        && request.resource.data.updatedAt == request.time;
    }
    // Shake-to-report / "Report a problem" (V2). Create-only for verified members whose server-owned
    // membership document exists; the document id is the client-generated report UUID so a retry cannot create a
    // second report (a repeat create is an update, which is denied). No client read, list, update or delete:
    // admins/organizers read through the console or a later admin UI. Strict allow-list and size limits; the only
    // identifier is the caller's own uid (no name, email, token or company).
    match /bugReports/{reportId} {
      function bugScreen(value) {
        return value in ['home', 'rewards', 'myEvents', 'profile', 'event', 'participants', 'album', 'challenge', 'other'];
      }
      function bugDiagnosticsValid(d) {
        return d is map
          && d.keys().hasOnly(['appVersion', 'appBuild', 'osVersion', 'deviceModel', 'locale', 'screen', 'installId'])
          && d.keys().hasAll(['appVersion', 'appBuild', 'osVersion', 'deviceModel', 'locale', 'screen', 'installId'])
          && d.appVersion is string && d.appVersion.size() <= 32
          && d.appBuild is string && d.appBuild.size() <= 32
          && d.osVersion is string && d.osVersion.size() <= 32
          && d.deviceModel is string && d.deviceModel.size() <= 40
          && d.locale is string && d.locale.size() <= 35
          && d.screen is string && bugScreen(d.screen)
          && d.installId is string && d.installId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$');
      }
      function validBugReport(data) {
        return data.keys().hasOnly(['uid', 'category', 'description', 'source', 'screen', 'diagnostics',
            'screenshotPath', 'screenshotBytes', 'createdAt'])
          && data.keys().hasAll(['uid', 'category', 'description', 'source', 'screen', 'createdAt'])
          && data.uid == request.auth.uid
          && data.category in ['bug', 'confusing', 'looksWrong', 'idea', 'unspecified']
          && data.description is string && data.description.size() <= 1000
          && (data.category != 'unspecified' || data.description.trim().size() >= 10)
          && data.source in ['shake', 'profile']
          && data.screen is string && bugScreen(data.screen)
          && (!('diagnostics' in data.keys()) || bugDiagnosticsValid(data.diagnostics))
          && (('screenshotPath' in data.keys()) == ('screenshotBytes' in data.keys()))
          && (!('screenshotPath' in data.keys())
              || (data.screenshotPath == 'bugReports/' + request.auth.uid + '/' + reportId + '.jpg'
                  && data.screenshotBytes is int && data.screenshotBytes > 0 && data.screenshotBytes <= 409600))
          && data.createdAt == request.time;
      }
      allow create: if verified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && reportId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
        && validBugReport(request.resource.data);
    }
    // --- Event photo albums (photos module, docs/contracts/callables.md#event-photo-albums) ---
    // Album documents are written only by finalizeEventPhotoV1 (Admin SDK); commentCount is server-owned
    // (onPhotoCommentCreated). Verified same-company members read albums (get, including a missing photo;
    // lists need a limit <= 100). The path scopes the tenant and only the server writes these documents.
    match /companies/{companyId}/events/{eventId}/photos/{photoId} {
      allow get: if sameCompany(companyId) && (resource == null || resource.data.companyId == companyId);
      allow list: if sameCompany(companyId) && request.query.limit != null && request.query.limit <= 100;
    }
    // Photo comments: verified same-company members append their own comment to an existing photo of this
    // company; no edit/delete. The ID is the client-generated commentId, so a retry never duplicates. Author
    // display fields must equal the caller's server-owned profile; text trimmed, 1..2000 characters.
    match /companies/{companyId}/events/{eventId}/photos/{photoId}/comments/{commentId} {
      function commentPhotoPath() {
        return /databases/$(database)/documents/companies/$(companyId)/events/$(eventId)/photos/$(photoId);
      }
      function validComment(data) {
        let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return data.keys().hasOnly(['companyId', 'photoId', 'authorId', 'authorName', 'authorAvatarId', 'text', 'createdAt'])
          && data.keys().hasAll(['companyId', 'photoId', 'authorId', 'authorName', 'authorAvatarId', 'text', 'createdAt'])
          && data.companyId == companyId && data.photoId == photoId && data.authorId == request.auth.uid
          && data.authorName == profile.displayName && data.authorAvatarId == profile.avatarId
          && data.text is string && data.text.size() >= 1 && data.text.size() <= 2000 && data.text == data.text.trim()
          && data.createdAt == request.time;
      }
      allow get: if sameCompany(companyId) && (resource == null || resource.data.companyId == companyId);
      allow list: if sameCompany(companyId) && request.query.limit != null && request.query.limit <= 100;
      allow create: if sameCompany(companyId) && commentId.matches('^[A-Za-z0-9_-]{8,128}$')
        && exists(commentPhotoPath()) && get(commentPhotoPath()).data.companyId == companyId
        && validComment(request.resource.data);
    }
    // --- Coworker invitations (invites module, docs/contracts/callables.md#coworker-invitations) ---
    // Invites live at companies/{c}/invites/{eventId_toUserId} and are written only by sendInviteV1 /
    // respondToInviteV1 (Admin SDK). Only the sender and the recipient read them: get checks the stored
    // sender/recipient, and lists must carry a limit <= 50 and pin one of the two fields to the caller so
    // the query itself proves ownership (single-field indexes only).
    match /companies/{companyId}/invites/{inviteId} {
      allow get: if sameCompany(companyId)
        && (resource == null || (resource.data.companyId == companyId
          && (resource.data.toUserId == request.auth.uid || resource.data.fromUserId == request.auth.uid)));
      allow list: if sameCompany(companyId)
        && request.query.limit != null && request.query.limit <= 50
        && resource.data.companyId == companyId
        && (resource.data.toUserId == request.auth.uid || resource.data.fromUserId == request.auth.uid);
    }
    // In-app notifications (invite notices today): the recipient reads their own and may flip only isRead;
    // the server creates them. No client create or delete.
    match /users/{uid}/notifications/{notificationId} {
      allow get: if own(uid);
      allow list: if own(uid) && request.query.limit != null && request.query.limit <= 50;
      allow update: if own(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        && request.resource.data.isRead is bool;
    }
    // inviteRateLimits is server-only and falls through to the deny-all rule below.
    // users/{uid}/devices (registerDeviceV1/unregisterDeviceV1), events/{e}/pushReceipts and
    // emulatorPushOutbox are server-only and fall through to the deny-all rule below.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
