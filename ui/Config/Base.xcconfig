// Committed defaults for the DIP app target (ADR 0007).
// The Google sign-in URL scheme must equal REVERSED_CLIENT_ID from your local
// GoogleService-Info.plist. Put it in ui/Config/Local.xcconfig (untracked);
// copy Local.example.xcconfig to start. Without it, Google sign-in cannot
// return to the app, and the app reports that sign-in is not configured.
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.dip-not-configured

// Paid team AX2A775SS6 (bundle work.letsdip.app). Defaults sign with Associated Domains, push and App Attest.
// A contributor on a free Personal Team overrides DEVELOPMENT_TEAM and DIP_ENTITLEMENTS = Config/DIP.entitlements in Local.xcconfig.
DEVELOPMENT_TEAM = AX2A775SS6
DIP_ENTITLEMENTS = Config/DIP-Paid-Push.entitlements

// Push client feature flag: ON. Delivery needs the APNs key uploaded in Firebase (docs/design/push-client.md).
DIP_PUSH_ENABLED = YES

#include? "Local.xcconfig"
