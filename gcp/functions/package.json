{
  "name": "@dip/functions",
  "version": "0.0.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts ../tests/unit/*.test.ts",
    "coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-exclude=\"src/generated/**\" --test-coverage-lines=70 tests/unit/*.test.ts ../tests/unit/*.test.ts"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "openai": "^7.57.0",
    "sharp": "^0.34.5",
    "tldts": "7.4.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "caniemail": "^2.0.2",
    "html-validate": "^11.21.1",
    "htmlparser2": "^10.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
