// Turns the push client ON. Include it from the untracked ui/Config/Local.xcconfig with ONE line:
//   #include "Push.xcconfig"
// Needs the paid Apple Developer team, the APNs key uploaded in Firebase and the Push capability on the App ID
// (docs/design/push-client.md). Use it INSTEAD of a DIP_ENTITLEMENTS line in Local.xcconfig.
DIP_PUSH_ENABLED = YES
DIP_ENTITLEMENTS = Config/DIP-Paid-Push.entitlements
