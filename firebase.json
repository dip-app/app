{
  "functions": [
    {
      "source": "gcp/functions",
      "codebase": "dip",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "tests",
        "**/*.test.ts",
        "**/*-debug.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "gcp/firestore.rules",
    "indexes": "gcp/firestore.indexes.json"
  },
  "storage": {
    "rules": "gcp/storage.rules"
  },
  "hosting": [
    {
      "site": "letsdip",
      "appAssociation": "NONE",
      "public": "site-dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "trailingSlash": true,
      "redirects": [
        {
          "source": "/admin/roster{,/}",
          "destination": "/admin/members/?status=invited",
          "type": 301
        },
        {
          "source": "/admin/themes{,/}",
          "destination": "/admin/challenges/",
          "type": 301
        },
        {
          "source": "/admin/themes/new{,/}",
          "destination": "/admin/challenges/new/",
          "type": 301
        },
        {
          "source": "/admin/themes/edit{,/}",
          "destination": "/admin/challenges/edit/",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "/img/covers-dyn/**",
          "function": {
            "functionId": "coverImageV1",
            "region": "us-central1"
          }
        },
        {
          "source": "/.well-known/apple-app-site-association",
          "destination": "/aasa/apple-app-site-association.json"
        },
        {
          "source": "/e/**",
          "function": {
            "functionId": "eventSharePageV1",
            "region": "us-central1"
          }
        },
        {
          "source": "/u/**",
          "function": {
            "functionId": "emailUnsubscribeV1",
            "region": "us-central1"
          }
        },
        {
          "source": "/o/**",
          "function": {
            "functionId": "emailOpenV1",
            "region": "us-central1"
          }
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            }
          ]
        },
        {
          "source": "/admin{,/**}",
          "headers": [
            {
              "key": "Content-Security-Policy-Report-Only",
              "value": "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://apis.google.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.googleapis.com https://*.googleusercontent.com https://*.ggpht.com https://pixabay.com https://cdn.pixabay.com; font-src 'self'; connect-src 'self' https://*.googleapis.com https://*.cloudfunctions.net https://*.run.app https://www.google.com/recaptcha/; frame-src https://*.firebaseapp.com https://accounts.google.com https://www.google.com/recaptcha/ https://recaptcha.google.com; worker-src 'self' blob:"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
            }
          ]
        },
        {
          "source": "/.well-known/apple-app-site-association",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=300"
            }
          ]
        },
        {
          "source": "/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/admin/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/img/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        }
      ]
    },
    {
      "site": "team05-dip",
      "public": "apps/redirect",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/:path*",
          "destination": "https://letsdip.work/:path*",
          "type": 301
        },
        {
          "source": "/",
          "destination": "https://letsdip.work/",
          "type": 301
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        }
      ]
    }
  ],
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
