          "format": "date-time"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "updatedBy": {
          "type": "string",
          "description": "Server-owned: UID of the organizer whose updateEventV1 wrote the current revision."
        },
        "changeLog": {
          "type": "array",
          "description": "Server-owned, optional: latest 50 user-visible changes, oldest first (onEventChanged trigger).",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/EventChangeLogEntry"
          }
        }
      },
