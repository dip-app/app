        "companyId",
        "title",
        "description",
        "tagIds",
        "coverImageURL",
        "startTime",
        "endTime",
        "venue",
        "costCents",
        "costNote",
        "capacity",
        "pointsValue",
        "isOutdoor",
        "status",
        "attendeeCount",
