// Committed defaults for the DIP app target (ADR 0007).
// The Google sign-in URL scheme must equal REVERSED_CLIENT_ID from your local
// GoogleService-Info.plist. Put it in ui/Config/Local.xcconfig (untracked);
// copy Local.example.xcconfig to start. Without it, Google sign-in cannot
// return to the app, and the app reports that sign-in is not configured.
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.dip-not-configured

// Entitlements file for the app target. The default has no Associated Domains so free Personal Team
// builds sign. A paid team overrides this in Local.xcconfig with Config/DIP-Paid.entitlements.
DIP_ENTITLEMENTS = Config/DIP.entitlements

// Push client feature flag. Real delivery additionally needs the paid team's APNs key and the aps-environment
// entitlement; leave NO until then. To enable, add `#include "Push.xcconfig"` to Local.xcconfig, do not edit this
// default (docs/design/push-client.md).
DIP_PUSH_ENABLED = NO

#include? "Local.xcconfig"
