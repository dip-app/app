    "EventChangeLogEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "by": {
          "type": "string",
          "minLength": 1,
          "description": "Editor UID from Event.updatedBy, or \"organizer\" when the writer is unknown."
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/EventFieldChange"
          }
        }
      },
      "required": [
        "at",
        "by",
        "revision",
        "changes"
