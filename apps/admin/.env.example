# Copy to .env.local (gitignored) to run the portal against Firebase instead of the local mock.
# Values come from `firebase apps:sdkconfig web <appId> --project team05-dip`. Web API keys identify the
# project and are not secrets, but keep real values out of the repo anyway. Next.js inlines these at build time.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=team05-dip
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: defaults to <project>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# reCAPTCHA Enterprise site key registered for this web app in App Check (production callables enforce it).
NEXT_PUBLIC_APPCHECK_SITE_KEY=
# Local development only: an App Check debug token ("true" prints one in the browser console).
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=
# Local emulators only (Auth 9099, Firestore 8080, Functions 5001): e.g. 127.0.0.1
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=
